#!/usr/bin/env bash
if [[ $(hyprctl -j getoption animations.enabled | jq -r .bool) == true ]]; then
    hyprctl eval 'hl.config({
        animations = { enabled = false },
        decoration = { rounding = 0, blur = { enabled = false } },
        general    = { gaps_in = 0, gaps_out = 0 },
    })'
else
    hyprctl reload
fi
