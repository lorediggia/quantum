#!/usr/bin/env bash
a=$(tput setaf 4) y=$(tput setaf 3) g=$(tput setaf 2) d=$(tput setaf 8) r=$(tput sgr0)
echo -n "$a󰚰$r "
exec 3< <(checkupdates 2>/dev/null)
aur=$(yay -Qua 2>/dev/null) repo=$(cat <&3)
n=$(printf '%s\n%s\n' "$repo" "$aur" | grep -c .)
if ((n)); then
    echo "$n · $(uname -r)"
    [[ $repo ]] && echo "$d$repo$r"
    [[ $aur ]] && echo "$y$aur$r"
    read -rp "$a󰚰$r [Y/n] " ok
    [[ ${ok,,} == n* ]] || { yay -Syu --noconfirm && echo "$g󰄬$r"; }
else
    echo "$g󰄬$r"
fi
read -rsn1 -p "$d…$r"
